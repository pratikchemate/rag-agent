# Enterprise Knowledge AI - Environment Variables Template
ENVIRONMENT=development
API_PREFIX=/api/v1
LOG_LEVEL=INFO

# OpenRouter Configuration (Backend only - never expose in frontend)
OPENROUTER_API_KEY=replace_me
# Ordered allowlist of free models. Each entry MUST end in ":free"
OPENROUTER_MODELS=liquid/lfm-2.5-2.6b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_APP_TITLE=Enterprise Knowledge AI
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_TIMEOUT_SECONDS=45
OPENROUTER_MAX_RETRIES=1
OPENROUTER_REASONING_EFFORT=low
ALLOW_PAID_MODEL=false

# Shared free-tier LLM quota tracking
LLM_DAILY_REQUEST_BUDGET=40

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace_me
SUPABASE_SECRET_KEY=replace_me
# Database connection string:
# For local dev / docker pgvector: postgresql+psycopg://postgres:postgres@localhost:5432/postgres
# For Supabase deployment: use Session Pooler host at port 5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
SIGNUP_MODE=invite

# Retrieval & Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=8
EMBEDDING_THREADS=1
EMBEDDING_CACHE_DIR=.fastembed_cache
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RRF_K=60
ENABLE_QUERY_REWRITE=true
MAX_RETRIEVAL_ATTEMPTS=2
MIN_RETRIEVAL_SIMILARITY=0.50
EVIDENCE_LOW_KW_THRESHOLD=0.15
EVIDENCE_LOW_KW_MIN_SIMILARITY=0.72
EVIDENCE_SUBCRITICAL_SIMILARITY=0.63
EVIDENCE_SUBCRITICAL_MIN_KW=0.50
EVIDENCE_SCORE_GAP_CEILING=0.65
EVIDENCE_SCORE_GAP_MIN=0.05
EVIDENCE_VECTOR_ONLY_MIN_SIMILARITY=0.65
EVIDENCE_KEYWORD_ONLY_MIN_SCORE=0.45
MAX_OUTPUT_TOKENS=1500

# Request bounds & Rate limits
MAX_UPLOAD_MB=5
MAX_DOCUMENTS_PER_USER=25
MAX_CHUNKS_PER_DOCUMENT=300
MAX_QUESTION_LENGTH=2000
MAX_CONTEXT_CHARS=16000
CHAT_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=3
STALE_PROCESSING_MINUTES=15

# CORS: comma-separated exact origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Storage Bucket
SUPABASE_STORAGE_BUCKET=source-documents
